%% =========================================================================
%% SkyBot learning dependency map
%% Document control: asset, not a controlled docs/ record (docs/README.md §2
%% reserves docs/ IDs for authored documents). Custodian: repository
%% maintainer. State: Active reference, written 2026-10-20 from the
%% implemented code and the records ASS-003, ASS-006, RES-001, RES-004 and
%% RES-005. Git history is the revision history. If the code and this map
%% disagree, the code governs: update this file in the same change.
%%
%% SCOPE: only what SKYBOT LEARNS FROM or LEARNS WITH. Every learner, every
%% signal that trains one, every store, every gate, every config switch that
%% changes learning, and the persistence that carries learning across
%% launches. Evaluation-only items are drawn dotted and never feed back
%% (docs/decisions/adr-002-evaluator-state-is-not-a-learning-input.md).
%%
%% HOW TO READ: solid arrow = data or signal flows (label says which);
%% thick arrow = the main learning loop; dotted arrow = measurement only, or
%% a config switch acting on a component; dashed box = not built yet.
%% Not claimed here: that any dependency works well. Live status is in ASS-003.
%% =========================================================================

%% ---------------------------------------------------------------- GAMES
subgraph ENV["1. Games and timing"]
  direction TB
  vz["ViZDoom adapter<br/>real-time clock thread, 35 tics per s"]
  pl["Player adapter<br/>real Chocolate Doom: screen capture + keys"]
  mc["MineRL adapter<br/>synchronous, one action per step"]
  uni["UniversalControllerWrapper<br/>48 action slots + per-game valid mask"]
  held["Held buttons<br/>atomic pair (vector, slot), tagged per tic"]
  exe["Executed action per interval<br/>executed_action, held_action, purity, decision_tics"]
  life["Life boundaries<br/>death, exit, rewind, restart, heal, standby gap"]
  stuck["Stuck watch + rewind ring<br/>reward-stagnation verdict"]
end

%% -------------------------------------------------------------- SENSING
subgraph SENSE["2. Senses (inputs a player has)"]
  direction TB
  frame["Frame o_t<br/>3x128x128 pixels"]
  bus["Sensor bus<br/>proprio 5170 | screen_fx | dead reckoning | motion | light | sky | tempo | audio | fovea"]
  guard["RED sensor guard<br/>engine-only fields never enter the brain"]
  viewkey["Frozen view encoder<br/>_view_key, the agent's own view embedding"]
end

%% --------------------------------------------------------- REAL-TIME CREDIT
subgraph RTC["3. Real-time credit (core/realtime_credit.py)"]
  direction TB
  rtx["_rt_exec<br/>swap chosen for executed action"]
  look["_acting_latent<br/>policy lookahead: imagine_step posterior with held action"]
  cdelay["CreditDelay<br/>pays each decision the next interval's reward"]
  relabel["Replay relabel<br/>new[t] = old[t-1] for unstamped real-time buffers"]
  stamp["action_semantics stamp<br/>executed"]
  standby["Standby actor<br/>plays while the loop trains, stores nothing"]
end

%% ------------------------------------------------------------ WORLD MODEL
subgraph WM["4. World model (world_model/rssm.py, DreamerV3-style)"]
  direction TB
  enc["Encoder<br/>hidden 128 at tiny"]
  rssm["RSSM state<br/>h deterministic GRU + z categoricals"]
  post["Posterior q(z | h, embed)"]
  prior["Prior p(z | h)"]
  kl["KL(post || prior)<br/>free-nats floor, z-info reported unclamped"]
  dec["Decoder, reconstruction SUMMED over pixels"]
  rew["Reward head"]
  cont["Continue head"]
  flow["Flow head<br/>motion from consecutive frames"]
  inv["Inverse-dynamics head<br/>predicts a_t from embeddings of o_t, o_t+1"]
  lat["Latent-horizon heads<br/>horizons 4 and 16"]
  symdec["Symbolic decoder<br/>off in Doom"]
  align["causal_align<br/>shifts actions one step"]
  infer["Inference copy<br/>published every 4 gradient steps"]
  trainer["Async WM trainer<br/>fused Adam, bf16, grad checkpoint"]
  wlock["World-model param lock"]
  imagine["imagine_step / imagine_trajectory"]
end

%% ---------------------------------------------------------------- REPLAY
subgraph REP["5. Experience store (world_model/replay_buffer.py)"]
  direction TB
  rbuf["MultiStreamReplayBuffer<br/>one ReplayBuffer per stream"]
  cols["Columns: observations uint8 | actions | rewards | dones | restarts | priorities | proprio"]
  budget["MEMORY_BUDGET<br/>charge first block, request every grow, bytes_per_row"]
  newest["newest_sequence<br/>never-trained window, fresh-data loss"]
  samp["Sequence sampler<br/>prefetch, terminal fraction, prioritised"]
  persist["Replay persist<br/>save once per stop, relabel on load, merge a cut stream"]
end

%% -------------------------------------------------------------- CURIOSITY
subgraph CUR["6. Intrinsic signals (curiosity/, infra/)"]
  direction TB
  icm["ICM forward model<br/>trained every step"]
  lp["Learning-progress reward<br/>median/std normalised, clipped"]
  gate["Action-attribution gate<br/>prediction with a_t vs null action"]
  expl["Exploration ratio<br/>scales LP by mastered skills"]
  epi["Episodic novelty<br/>kNN over this life's views, weight 0.07"]
  epimem["Per-stream per-life view memory<br/>k=10, capacity 2000, resets at life boundary"]
  vnov["View novelty<br/>hash buckets, 1/sqrt n"]
  imagc["Imagination curiosity<br/>rollouts from the current state"]
  emp["Empowerment<br/>gamma Phi' - Phi every 25 steps"]
  hab["Habituation and boring-view factor"]
  farm["Farm detector and damp<br/>keyed on the perceptual cell of the view"]
  reach["Reach, persistence, gaze-level potentials<br/>about 0 in Doom"]
  covg["Coverage and gaze<br/>weight 0 in the universal brain"]
  mixer["RewardMixer<br/>intrinsic 0.7 / extrinsic 0.3, return-ratio cap"]
  ext["Extrinsic reward<br/>0 in Doom by design"]
  scoutr["Scout reward<br/>same function as stream 0, per-stream state"]
end

%% ----------------------------------------------------------------- POLICY
subgraph POL["7. Policy and PPO (policy/actor_critic.py)"]
  direction TB
  cond["Knowledge conditioner<br/>gates the knowledge vector"]
  aug["_augment<br/>latent + proprio + gated knowledge"]
  actor["Actor trunk<br/>actor.shared, action head 72 = 48 slots + 24 options"]
  critic["Critic<br/>symlog value"]
  mask["Valid-action mask<br/>option executor ANDs per-stream mask"]
  bound["Logit range bound 5.0<br/>over valid actions only"]
  ent["Entropy bonus 0.03<br/>x3 boost after a features-only resume"]
  roll["Rollout buffer<br/>obs feats, action, log-prob, value, reward, done"]
  gae["GAE<br/>gamma 0.995, lambda 0.95, per stream, SMDP-aware"]
  boot["Bootstrap last value<br/>with proprio and lookahead feats"]
  advn["Advantage normalise and winsorise at 5"]
  ppo["PPO update<br/>minibatch 32, clip 0.2, lr 3e-4, grad clip 0.5"]
  klc["KL trust region<br/>whole-rollout k3 vs target_kl 0.05, freezes actor"]
  stats["Update stats<br/>explained variance, clip fraction, I(S;A), probe KL, grad norm, trip point"]
end

%% ----------------------------------------------------- OPTIONS AND SKILLS
subgraph SKL["8. Options, goals and knowledge"]
  direction TB
  optx["Option executor<br/>SMDP, tau, masks, learned slots"]
  bank["Skill bank<br/>byte copies of the shared policy"]
  goals["Achievement goals<br/>mint on extrinsic spike, repeatability gate"]
  probe["Probation and competence predictor"]
  kg["Knowledge graph<br/>asserted and retracted facts"]
  glue["Glue layer and knowledge integrator<br/>knowledge vector"]
  vlm["VLM symbolizer and vision magnet<br/>off for Doom"]
  skdisc["Skill discovery: surprise x agency, effect keys, probation<br/>planned, RES-005"]
end

%% --------------------------------------------------------------- DREAMING
subgraph DRM["9. Dreaming"]
  direction TB
  dactor["Dream actor-critic<br/>trained on imagined rollouts"]
  dtrain["Dream training<br/>batches per segment, activates after 2 segments"]
  distill["Dream-to-real distillation<br/>skipped below min weight, masked to valid actions"]
  prosp["Prospection and imagination policy<br/>_imagination_policy_fn, zero knowledge for scouts"]
end

%% -------------------------------------------------- SCALE AND PERSISTENCE
subgraph PER["10. Scale, growth and persistence"]
  direction TB
  scale["scale.json and SIZE_LADDER<br/>tiny 256/16/16, small, medium, live"]
  initsc["universal.initial_scale<br/>new brain starts tiny x 8"]
  auto["Autoscaler<br/>fresh-vs-train gap, plateau, z-info, VRAM, latency; advice only"]
  grow["grow_brain.py + growth.py<br/>function-preserving WM and policy growth"]
  restart["SCALE_RESTART + supervisor kind=scale"]
  ckpt["Checkpoint<br/>world_model, policy, optimizer, mixer, meta"]
  fprint["Reward fingerprint<br/>hash of reward-relevant config"]
  pfull["policy_full resume<br/>whole policy if fingerprint and shapes match"]
  pfeat["policy_features resume<br/>feature layers only + entropy boost"]
  refuse["Bare policy / dream_actor / curiosity<br/>refused by name"]
  life2["lifetime_timesteps<br/>survives relaunches"]
  super["Launcher and supervisor<br/>compose config, relaunch, crash-loop guard"]
  buf2["Memory ceiling<br/>buffer_growth 5.5 GB universal"]
end

%% ----------------------------------------------------- EVALUATION ONLY
subgraph EVAL["11. Evaluation only (never feeds learning)"]
  direction TB
  evalr["Doom evaluator<br/>kills, items, secrets, deaths, exits, map"]
  oracle["Oracle dead-reckoning drift and true position"]
  lagp["Replay lag probe<br/>shift -1 / 0 / +1"]
  ledger["Reward ledger and census<br/>shares, farm flags"]
  telem["Learning telemetry<br/>per-segment learning.jsonl"]
  mcc["Minecraft mine_* counters<br/>answer key for skill discovery"]
  asspt["ASS-003 protocol<br/>OFF vs ON arms"]
end

%% ------------------------------------------------------- CONFIG SWITCHES
subgraph CFG["12. Config switches that change learning"]
  direction TB
  c_rt["realtime_credit.enabled, policy_lookahead, ppo_delay, legacy_replay, bootstrap_proprio"]
  c_kl["policy.kl_check, kl_check_every, target_kl"]
  c_lb["policy.logit_bound_valid_only, logit_range"]
  c_hold["policy.hold_intrinsic_without_extrinsic"]
  c_sc["policy.scouts_same_reward"]
  c_dd["dream_training.distill_min_weight, distill_masked"]
  c_farm["infra.farm_key view | engine"]
  c_wm["world_model.recon_reduction sum, inverse_input embed, fused_adam"]
  c_ep["curiosity.episodic_weight, episodic k and capacity"]
  c_res["loop.resume_components, policy_features_boost"]
  c_bg["world_model.buffer_growth"]
  c_as["infra.autoscaler.actuate"]
end

